{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pi-harness/run-request",
  "title": "RunRequest",
  "description": "Body of POST /api/run. Response: { \"run_id\": string }.",
  "type": "object",
  "required": ["model", "defenses", "families", "reps", "seed"],
  "properties": {
    "model": { "type": "string" },
    "defenses": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "families": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "reps": { "type": "integer", "minimum": 1, "maximum": 50 },
    "seed": { "type": "integer" }
  }
}
